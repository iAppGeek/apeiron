# Serves the static pharos build and proxies /ws to the blotter server.
# Runs unprivileged (nginxinc/nginx-unprivileged), so it listens on 8080.
# This is an envsubst template (the image renders it into conf.d on start). WS_UPSTREAM is the host:port that
# /ws is proxied to; it defaults to antikythera:4000 and the resilience profile points it at toxiproxy.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's embedded DNS. A variable in proxy_pass makes nginx re-resolve the name, so the proxy keeps
  # working when the antikythera container is recreated with a new address.
  resolver 127.0.0.11 valid=10s ipv6=off;

  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml application/wasm;

  location /ws {
    set $ws_upstream http://${WS_UPSTREAM};
    proxy_pass $ws_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Quiet sockets (a paused client) must not be reaped; the client pings every 2s regardless.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_buffering off;
  }

  # Vite emits content-hashed file names, so these never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The entry point must always be revalidated so a new deploy is picked up.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
