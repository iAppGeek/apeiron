{
  "name": "@apeiron/e2e",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list,html --max-failures=5",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e:resilience": "playwright test -c playwright.resilience.config.ts",
    "e2e:resilience:smoke": "RESILIENCE_SMOKE=1 playwright test -c playwright.resilience.config.ts --grep @smoke"
  },
  "dependencies": {
    "@apeiron/hermes": "workspace:*",
    "@apeiron/iris": "workspace:*",
    "@apeiron/logos": "workspace:*",
    "@apeiron/mnemosyne": "workspace:*"
  },
  "devDependencies": {
    "@apeiron/eslint-config": "workspace:*",
    "@apeiron/tsconfig": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
