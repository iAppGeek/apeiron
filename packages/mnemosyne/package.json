{
  "name": "@apeiron/mnemosyne",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/repository.contract.d.ts",
      "default": "./dist/repository.contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@apeiron/logos": "workspace:*",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@apeiron/eslint-config": "workspace:*",
    "@apeiron/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "9.0.2"
    }
  }
}
