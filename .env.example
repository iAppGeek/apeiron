# Copy to .env (git-ignored) for local overrides. Never commit real secrets.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=blotter
NATS_URL=nats://localhost:4222
PORT=4000
# antikythera: rows reserved up front, view cache caps, largest block a client may request
STORE_CAPACITY=1500000
VIEW_CACHE_MAX_VIEWS=64
VIEW_CACHE_MAX_MB=384
MAX_BLOCK_ROWS=5000
# antikythera: how long startup waits for a price for every pair, and how few pending entries count as caught up
PRICE_WAIT_MS=10000
CATCHUP_MAX_PENDING=100
# antikythera: views built before it is ready (default, or a JSON file of {traders, req}), passes over each, and the drain time at shutdown
WARM_VIEWS=default
WARM_ROUNDS=3
DRAIN_MS=2000
SEED_ROWS=1000000
SEED=42
# Optional ISO timestamp pinning the dataset's "now" (unset = wall clock)
SEED_NOW=
BATCH_SIZE=10000
# true = drop the orders collection and re-seed (fresh 6-month window)
SEED_RESET=false
# antikythera: flush tick (ms) and the most time one flush may spend patching views
FLUSH_MS=50
FLUSH_BUDGET_MS=40
# MongoDB WiredTiger cache cap in GB. 1 keeps a shared 6 GB Docker VM from swapping; raise it (for example 4) on a 16 GB host
MONGO_CACHE_GB=1
MAX_TRACKED_BLOCKS=100
LOAD_PRESET=medium
LOG_LEVEL=info
REGISTRY=local
TAG=dev
# hermes (mock middleware): simulator step, health port, optional RNG seed (unset = clock)
STEP_MS=100
HEALTH_PORT=4100
HERMES_SEED=
# helios (price feed): optional RNG seed (unset = clock), health port
HELIOS_SEED=
# themis (order service): group commit window (ms) and size, and 1 to rebuild the ORDER_STATE projection at start
GROUP_COMMIT_MS=20
GROUP_COMMIT_MAX=500
REBUILD_PROJECTION=0
# Interface the web (8080) and Grafana (3001) ports bind to. Loopback by default; the remote box sets 0.0.0.0 for
# the web port and relies on its security group (allowed_cidr) to keep everyone else out.
WEB_BIND=127.0.0.1
GRAFANA_BIND=127.0.0.1
