# Copy to .env (git-ignored) for local overrides. Never commit real secrets.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=blotter
NATS_URL=nats://localhost:4222
DB_ADAPTER=mongo
SEED_ROWS=1000000
SEED=42
# Optional ISO timestamp pinning the dataset's "now" (unset = wall clock)
SEED_NOW=
BATCH_SIZE=10000
# true = drop the orders collection and re-seed (fresh 6-month window)
SEED_RESET=false
FLUSH_MS=100
WRITE_BEHIND_MS=500
MAX_TRACKED_BLOCKS=100
LOAD_PRESET=medium
LOG_LEVEL=info
REGISTRY=local
TAG=dev
